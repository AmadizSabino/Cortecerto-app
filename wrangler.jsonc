// Cloudflare Workers static-assets deploy. Cloudflare runs `npx wrangler deploy` from the repo root,
// which first runs the build below, then uploads app/dist.
{
  "name": "cortecerto-app",
  "compatibility_date": "2026-11-01",
  // The Worker answers /api/* (booking emails) and serves the app for everything else.
  "main": "worker/index.ts",
  // Keep variables added in the Cloudflare dashboard (e.g. EMAIL_FROM) on each deploy.
  "keep_vars": true,
  // Worker logs (including browser error reports) in Cloudflare > Workers > cortecerto-app > Logs.
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://ahevsnyhcyyaojdzfgse.supabase.co",
    // The address in emails (booking notices, reminders, payment requests) and the uptime check.
    "APP_URL": "https://cortecerto.pt"
  },
  // cortecerto.pt is the address. The others (www, .com.pt, .eu) send people there (worker/index.ts).
  // Each domain must be in this Cloudflare account (Websites > Add a domain) before this deploys.
  "routes": [
    { "pattern": "cortecerto.pt", "custom_domain": true },
    { "pattern": "www.cortecerto.pt", "custom_domain": true },
    { "pattern": "cortecerto.eu", "custom_domain": true },
    { "pattern": "www.cortecerto.eu", "custom_domain": true }
    // Add these once the zone is Active in Cloudflare (the redirect to .pt is already in worker/index.ts):
    // { "pattern": "cortecerto.com.pt", "custom_domain": true },
    // { "pattern": "www.cortecerto.com.pt", "custom_domain": true }
  ],
  // Required by `wrangler preview`, which Cloudflare runs for non-main branches. Empty is fine.
  "previews": {},
  // 08:00 UTC (8 or 9 in Lisbon): automatic payment reminders and the daily summary, each only when switched on in /admin.
  // Every 5 minutes: uptime check and AI budget check (worker/ops.ts).
  "triggers": { "crons": ["0 8 * * *", "*/5 * * * *"] },
  "build": {
    "command": "cd app && npm ci && npm run build"
  },
  "assets": {
    "directory": "./app/dist",
    // Serve index.html for app routes such as /s/salon-name and /painel.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Send /api/* to the Worker before the single-page fallback catches it, and the home page and
    // salon booking pages too, so their link previews (WhatsApp, Instagram) are filled in (worker/meta.ts).
    "run_worker_first": ["/api/*", "/", "/s/*"]
  }
}
