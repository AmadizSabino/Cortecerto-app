// Cloudflare Workers static-assets deploy. Cloudflare runs `npx wrangler deploy` from the repo root,
// which first runs the build below, then uploads app/dist.
{
  "name": "cortecerto-app",
  "compatibility_date": "2026-11-01",
  // The Worker answers /api/* (booking emails) and serves the app for everything else.
  "main": "worker/index.ts",
  // Keep variables added in the Cloudflare dashboard (e.g. EMAIL_FROM) on each deploy.
  "keep_vars": true,
  // Worker logs (including browser error reports) in Cloudflare > Workers > cortecerto-app > Logs.
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://ahevsnyhcyyaojdzfgse.supabase.co"
  },
  // Required by `wrangler preview`, which Cloudflare runs for non-main branches. Empty is fine.
  "previews": {},
  // 08:00 UTC (8 or 9 in Lisbon): automatic payment reminders, sent only when switched on in /admin.
  "triggers": { "crons": ["0 8 * * *"] },
  "build": {
    "command": "cd app && npm ci && npm run build"
  },
  "assets": {
    "directory": "./app/dist",
    // Serve index.html for app routes such as /s/salon-name and /painel.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Send /api/* to the Worker before the single-page fallback catches it.
    "run_worker_first": ["/api/*"]
  }
}
